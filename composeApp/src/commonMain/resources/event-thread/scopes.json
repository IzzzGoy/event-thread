  {
    "name": "TodoTabs",
    "description": "The selected list - app state, alive for the whole session",
    "dependsOn": [
      "TodoDomain"
    ],
    "handlers": [
      {
        "input": {
          "name": "org.company.sample.SelectList"
        },
        "output": {
          "kind": "data",
          "type": {
            "kind": "primitive",
            "value": "selectedList",
            "typeKey": "String"
          }
        },
        "examples": [
          {
            "name": "selects",
            "given": "Work",
            "event": {
              "name": "Personal"
            },
            "expect": "Personal"
          }
        ]
      }
    ]
  },
  {
    "name": "TodoDraft",
    "description": "Text of the todo being typed or edited",
