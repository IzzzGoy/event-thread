    },
    {
      "name": "TodoTabs",
      "description": "The selected list - app state, alive for the whole session",
      "dependsOn": [
        "TodoDomain"
      ],
      "initial": {
        "selectedList": "'Work'"
      },
      "handlers": [
        {
          "input": {
            "name": "org.company.sample.SelectList"
          },
          "output": {
            "kind": "data",
            "type": {
              "kind": "primitive",
              "value": "selectedList",
              "typeKey": "String"
            }
          },
          "rule": "event.name",
          "examples": [
            {
              "name": "selects",
              "given": "Work",
              "event": {
                "name": "Personal"
              },
              "expect": "Personal"
            }
          ]
        }
      ]
    },
    {
      "name": "TodoDraft",
      "description": "Text of the todo being typed or edited",
      "params": {
        "kind": "primitive",
        "value": "params",
        "typeKey": "org.company.sample.TodoDraft.Params"
      },
      "handlers": [
        {
          "input": {
            "name": "org.company.sample.SetDraftText"
          },
          "output": {
            "kind": "data",
            "type": {
              "kind": "primitive",
              "value": "draft",
              "typeKey": "String"
            }
          },
          "rule": "event.text",
          "examples": [
            {
              "name": "replacesText",
              "given": "",
              "event": {
                "text": "hi"
              },
              "expect": "hi"
            }
          ]
        }
      ]
    },
    {
      "name": "Suggestions",
      "description": "Todo ideas loaded from a remote service - fully generated: request, Ktor API, containers.",
      "initial": {
        "failures": "0"
      },
      "handlers": [
        {
          "input": {
            "name": "LoadSuggestions"
          },
          "output": {
            "kind": "request",
            "call": "Ideas.suggest",
            "args": {
              "count": "3"
            },
            "into": {
              "kind": "generics",
              "baseClassName": "RemoteData",
              "field": "suggestions",
              "parameters": [
                {
                  "kind": "generics",
                  "baseClassName": "List",
                  "parameters": [
                    {
                      "kind": "created",
                      "name": "Suggestion"
                    }
                  ]
                }
              ]
            },
            "emits": [
              {
                "name": "SuggestionsFailed",
                "args": [
                  {
                    "kind": "primitive",
                    "value": "reason",
                    "typeKey": "String"
                  }
                ]
              }
            ],
            "onFailure": "emit SuggestionsFailed(error.message ?: 'unknown')",
            "policy": {
              "concurrency": "drop",
              "timeoutMs": 5000
            }
          },
          "examples": [
            {
              "name": "loads",
              "respond": [
                {
                  "text": "Water the plants"
                },
                {
                  "text": "Call mom"
                }
              ],
              "emits": []
            },
            {
              "name": "failureKeepsTheLastIdeas",
              "given": [
                {
                  "text": "Call mom"
                }
              ],
              "fail": "HTTP 503",
              "emits": [
                {
                  "reason": "HTTP 503"
                }
              ]
            }
          ]
        },
        {
          "input": {
            "name": "SuggestionsFailed",
            "args": [
              {
                "kind": "primitive",
                "value": "reason",
                "typeKey": "String"
              }
            ]
          },
          "output": {
            "kind": "data",
            "type": {
              "kind": "primitive",
              "value": "failures",
              "typeKey": "Int"
            }
          },
          "rule": "state + 1",
          "examples": [
            {
              "name": "counts",
              "given": 0,
              "event": {
                "reason": "x"
              },
              "expect": 1
            }
          ]
        }
      ]
    }
  ],
  "remote": [
    {
      "name": "Ideas",
      "description": "A suggestions service - faked in the sample by a Ktor MockEngine (typed/FakeIdeasServer.kt).",
      "endpoints": [
        {
          "name": "suggest",
          "method": "GET",
          "path": "suggestions",
          "args": [
            {
              "kind": "primitive",
              "value": "count",
              "typeKey": "Int"
            }
          ],
          "response": {
            "kind": "generics",
            "baseClassName": "List",
            "parameters": [
              {
                "kind": "created",
                "name": "Suggestion",
                "fields": [
                  {
                    "kind": "primitive",
                    "value": "text",
                    "typeKey": "String"
                  }
                ]
              }
            ]
          },
          "description": "[count] todo ideas."
        }
      ]
    }
  ]
}
