        },
        "output": {
          "kind": "data",
          "type": {
            "kind": "primitive",
            "value": "draft",
            "typeKey": "String"
          }
        },
        "examples": [
          {
            "name": "replacesText",
            "given": "",
            "event": {
              "text": "hi"
            },
            "expect": "hi"
          }
        ]
      }
