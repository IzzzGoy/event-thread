            "type": {
              "kind": "generics",
              "baseClassName": "List",
              "field": "todos",
              "parameters": [
                {
                  "kind": "primitive",
                  "value": "todo",
                  "typeKey": "org.company.sample.Todo"
                }
              ]
            }
          }
        },
        {
          "input": {
            "name": "org.company.sample.ToggleTodo"
          },
          "output": {
            "kind": "data",
            "type": {
              "kind": "generics",
              "baseClassName": "List",
              "field": "todos",
              "parameters": [
                {
                  "kind": "primitive",
                  "value": "todo",
                  "typeKey": "org.company.sample.Todo"
                }
              ]
            }
